generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum MemoType {
  lawsuit
  defense
  reply
  appeal
}

enum PlanCode {
  free
  basic
  pro
}

enum SoundMode {
  all
  urgent
  off
}

enum PaymentStatus {
  pending
  paid
  failed
  cancelled
}

enum TxType {
  topup
  subscription
  memo_purchase
  adjustment
}

enum ShariaKind {
  quran
  hadith
  fiqh
}

enum IntegrationProvider {
  google_drive
  onedrive
  email
  calendar
}

enum HearingKind {
  hearing
  objection_deadline
  appeal_deadline
}

model User {
  id              String    @id @default(cuid())
  name            String
  phone           String    @unique
  email           String    @unique
  passwordHash    String?
  phoneVerifiedAt DateTime?
  emailVerifiedAt DateTime?
  consentAt       DateTime
  consentVersion  String
  locale          String    @default("ar")
  jurisdiction    String    @default("SA")
  theme           String    @default("light")
  planCode            PlanCode  @default(free)
  planExpiresAt       DateTime?
  chatCount           Int       @default(0)
  chatCountPeriod     Int       @default(0)
  memoCountPeriod     Int       @default(0)
  periodStartedAt     DateTime  @default(now())
  wrappedDataKey      String
  notLawyerDeclaredAt DateTime?
  nationalIdEnc       String?
  planReminderKey     String?
  soundMode           SoundMode @default(all)
  expoPushToken   String?
  orgId           String?
  orgRole         String?
  notifyHearings  Boolean   @default(true)
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  country      Jurisdiction         @relation(fields: [jurisdiction], references: [code])
  organization Organization?        @relation("OrgMembers", fields: [orgId], references: [id])
  ownedOrg     Organization?        @relation("OrgOwner")
  sessions     Session[]
  otps         OtpChallenge[]
  cases        CaseFile[]
  chats        Chat[]
  memos        Memo[]
  documents    Document[]
  wallet       Wallet?
  transactions WalletTransaction[]
  invoices     Invoice[]
  payments     PaymentIntent[]
  saved        SavedItem[]
  integrations IntegrationAccount[]
  hearings      Hearing[]
  notifications Notification[]
  exportJobs    ExportJob[]
  assessments   CaseAssessment[]
  nafath        NafathRequest[]
}

model NafathRequest {
  id         String   @id @default(cuid())
  userId     String
  transId    String
  randomCode String
  status     String   @default("pending")
  createdAt  DateTime @default(now())
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
}

model Organization {
  id             String   @id @default(cuid())
  name           String
  ownerId        String   @unique
  seatLimit      Int      @default(5)
  letterheadName String   @default("")
  createdAt      DateTime @default(now())
  owner          User     @relation("OrgOwner", fields: [ownerId], references: [id])
  members        User[]   @relation("OrgMembers")
}

model OtpChallenge {
  id         String        @id @default(cuid())
  userId     String?
  adminId    String?
  purpose    String        @default("email_verify")
  target     String
  codeHash   String
  attempts   Int           @default(0)
  expiresAt  DateTime
  consumedAt DateTime?
  createdAt  DateTime      @default(now())
  user       User?         @relation(fields: [userId], references: [id], onDelete: Cascade)
  admin      AdminAccount? @relation(fields: [adminId], references: [id], onDelete: Cascade)

  @@index([target, consumedAt])
  @@index([adminId])
}

model Session {
  id          String    @id @default(cuid())
  userId      String
  refreshHash String    @unique
  expiresAt   DateTime
  revokedAt   DateTime?
  createdAt   DateTime  @default(now())
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model AdminAccount {
  id              String         @id @default(cuid())
  email           String         @unique
  passwordHash    String
  name            String
  emailVerifiedAt DateTime?
  createdAt       DateTime       @default(now())
  challenges      OtpChallenge[]
}

model CaseFile {
  id        String    @id @default(cuid())
  userId    String
  titleEnc     String
  jurisdiction String    @default("SA")
  court        String
  status    String    @default("open")
  notesEnc  String?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  country   Jurisdiction @relation(fields: [jurisdiction], references: [code])
  documents Document[]
  chats     Chat[]
  memos     Memo[]
  hearings  Hearing[]

  @@index([userId])
}

model Document {
  id         String   @id @default(cuid())
  userId     String
  caseId     String
  filename   String
  mime       String
  byteSize   Int
  pageCount  Int      @default(1)
  storageKey String
  ocrEnc     String?
  createdAt  DateTime @default(now())
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  caseFile   CaseFile @relation(fields: [caseId], references: [id], onDelete: Cascade)

  @@index([caseId])
}

model Chat {
  id        String   @id @default(cuid())
  userId    String
  caseId    String?
  titleEnc     String
  jurisdiction String   @default("SA")
  court        String
  memoType     MemoType @default(lawsuit)
  clientLocale String   @default("ar")
  createdAt    DateTime @default(now())
  updatedAt DateTime @updatedAt
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  country   Jurisdiction @relation(fields: [jurisdiction], references: [code])
  caseFile  CaseFile? @relation(fields: [caseId], references: [id])
  messages  Message[]
  memos     Memo[]

  @@index([userId, updatedAt])
}

model Message {
  id         String   @id @default(cuid())
  chatId     String
  userId     String
  role       String
  contentEnc String
  createdAt  DateTime @default(now())
  chat       Chat     @relation(fields: [chatId], references: [id], onDelete: Cascade)

  @@index([chatId, createdAt])
}

model Memo {
  id         String    @id @default(cuid())
  userId     String
  caseId     String?
  chatId     String?
  titleEnc     String
  jurisdiction String    @default("SA")
  court        String
  memoType   MemoType
  bodyEnc    String
  summaryEnc String    @default("")
  status     String    @default("draft")
  flagged    Boolean   @default(false)
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  country    Jurisdiction @relation(fields: [jurisdiction], references: [code])
  caseFile   CaseFile? @relation(fields: [caseId], references: [id])
  chat       Chat?     @relation(fields: [chatId], references: [id])
  citations   MemoCitation[]
  saved       SavedItem[]
  hearingPrep HearingPrep?

  @@index([userId, updatedAt])
}

model MemoCitation {
  id        String         @id @default(cuid())
  memoId    String
  articleId String?
  shariaId  String?
  memo      Memo           @relation(fields: [memoId], references: [id], onDelete: Cascade)
  article   Article?       @relation(fields: [articleId], references: [id])
  sharia    ShariaSource?  @relation(fields: [shariaId], references: [id])
}

model SavedItem {
  id        String   @id @default(cuid())
  userId    String
  kind      String
  memoId    String?
  articleId String?
  shariaId  String?
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  memo      Memo?    @relation(fields: [memoId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Law {
  id            String     @id @default(cuid())
  key           String
  nameAr        String
  nameEn        String
  sourceUrl     String
  version        String
  effectiveDate  DateTime
  issuedHijri    String     @default("")
  publishedHijri String     @default("")
  statusLabel    String     @default("")
  isSample       Boolean    @default(false)
  jurisdiction   String     @default("SA")
  courts         String[]
  createdAt     DateTime   @default(now())
  country       Jurisdiction @relation(fields: [jurisdiction], references: [code])
  articles      Article[]

  @@unique([jurisdiction, key])
}

model Article {
  id        String   @id @default(cuid())
  lawId     String
  number    String
  textAr    String
  textEn    String
  sourceUrl String
  isSample  Boolean  @default(false)
  law       Law      @relation(fields: [lawId], references: [id], onDelete: Cascade)
  citations MemoCitation[]

  @@unique([lawId, number])
  @@index([number])
}

model ShariaSource {
  id        String      @id @default(cuid())
  key       String
  kind      ShariaKind
  reference String
  textAr    String
  textEn    String
  sourceUrl String
  isSample     Boolean     @default(false)
  jurisdiction String      @default("SA")
  courts       String[]
  country      Jurisdiction @relation(fields: [jurisdiction], references: [code])
  citations MemoCitation[]

  @@unique([jurisdiction, key])
}

model CorpusEmbedding {
  id         String                       @id @default(cuid())
  targetType String
  targetId   String                       @unique
  embedding  Unsupported("vector(384)")
}

model Wallet {
  userId         String @id
  balanceHalalas Int    @default(0)
  currency       String @default("SAR")
  user           User   @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model WalletTransaction {
  id             String        @id @default(cuid())
  userId         String
  type           TxType
  amountHalalas  Int
  status         PaymentStatus @default(paid)
  idempotencyKey String        @unique
  description    String
  createdAt      DateTime      @default(now())
  user           User          @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
}

model Invoice {
  id              String   @id @default(cuid())
  userId          String
  number          String   @unique
  uuid            String   @unique
  subtotalHalalas Int
  vatRateBps      Int      @default(1500)
  vatHalalas      Int
  totalHalalas    Int
  sellerName      String
  sellerVat       String
  sellerAddress   String
  buyerName       String
  jurisdiction    String   @default("SA")
  currency        String   @default("SAR")
  qrTlvBase64     String
  lineDescription String
  issuedAt        DateTime @default(now())
  user            User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  country         Jurisdiction @relation(fields: [jurisdiction], references: [code])
}

model InvoiceSequence {
  id    Int @id @default(1)
  value Int @default(0)
}

model PaymentIntent {
  id             String        @id @default(cuid())
  userId         String
  purpose        String
  planCode       PlanCode?
  cycle          String?
  amountHalalas  Int
  jurisdiction   String        @default("SA")
  currency       String        @default("SAR")
  status         PaymentStatus @default(pending)
  idempotencyKey String        @unique
  gateway        String
  gatewayRef     String?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt
  user           User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  country        Jurisdiction  @relation(fields: [jurisdiction], references: [code])
  events         PaymentEvent[]
}

model PaymentEvent {
  id          String        @id @default(cuid())
  intentId    String
  eventKey    String        @unique
  payloadHash String
  createdAt   DateTime      @default(now())
  intent      PaymentIntent @relation(fields: [intentId], references: [id], onDelete: Cascade)
}

model IntegrationAccount {
  id           String              @id @default(cuid())
  userId       String
  provider     IntegrationProvider
  status       String              @default("pending")
  accountLabel String?
  accessEnc    String?
  refreshEnc   String?
  expiresAt    DateTime?
  createdAt    DateTime            @default(now())
  user         User                @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, provider])
}

model Hearing {
  id         String      @id @default(cuid())
  userId     String
  caseId     String
  kind       HearingKind
  occursAt   DateTime
  titleEnc   String
  reminderAt DateTime?
  remindedAt DateTime?
  createdAt  DateTime    @default(now())
  user       User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  caseFile   CaseFile    @relation(fields: [caseId], references: [id], onDelete: Cascade)

  @@index([reminderAt, remindedAt])
}

model Notification {
  id         String    @id @default(cuid())
  userId     String
  hearingId  String?
  kind       String    @default("hearing")
  priority   String    @default("normal")
  titleEnc   String    @default("")
  readAt     DateTime?
  createdAt  DateTime  @default(now())
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
}

model CaseAssessment {
  id        String   @id @default(cuid())
  userId    String
  court     String   @default("general")
  factsEnc  String
  resultEnc String
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
}

model HearingPrep {
  memoId    String   @id
  bodyEnc   String
  updatedAt DateTime @updatedAt
  memo      Memo     @relation(fields: [memoId], references: [id], onDelete: Cascade)
}

model ExportJob {
  id         String   @id @default(cuid())
  userId     String
  provider   String
  memoId     String
  status     String
  externalId String?
  createdAt  DateTime @default(now())
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model LocalizedText {
  id        String   @id @default(cuid())
  scope     String
  sourceId  String
  locale    String
  text      String
  status    String   @default("pending")
  error     String   @default("")
  updatedAt DateTime @updatedAt

  @@unique([scope, sourceId, locale])
  @@index([scope, sourceId])
}

model AdminNotice {
  id        String   @id @default(cuid())
  priority  String   @default("normal")
  status    String   @default("draft")
  createdAt DateTime @default(now())
}

model AuditLog {
  id         String   @id @default(cuid())
  actorType  String
  actorId    String?
  action     String
  entityType String?
  entityId   String?
  ip         String?
  createdAt  DateTime @default(now())

  @@index([createdAt])
}

model Jurisdiction {
  code         String @id
  currency     String
  minorPerUnit Int
  vatRateBps   Int
  users        User[]
  cases        CaseFile[]
  chats        Chat[]
  memos        Memo[]
  laws         Law[]
  sharia       ShariaSource[]
  courts       Court[]
  templates    DocumentTemplate[]
  plans        PlanSetting[]
  invoices     Invoice[]
  payments     PaymentIntent[]
}

model Court {
  jurisdiction String
  code         String
  country      Jurisdiction @relation(fields: [jurisdiction], references: [code])

  @@id([jurisdiction, code])
}

model DocumentTemplate {
  jurisdiction  String
  memoType      MemoType
  titleAr       String
  courtHeadings Json
  country       Jurisdiction @relation(fields: [jurisdiction], references: [code])

  @@id([jurisdiction, memoType])
}

model PlanSetting {
  jurisdiction  String   @default("SA")
  code          PlanCode
  priceHalalas  Int
  currency      String   @default("SAR")
  memoLimit     Int
  chatLimit     Int?
  validityDays  Int      @default(30)
  courts        String[] @default([])
  updatedAt     DateTime @updatedAt
  country       Jurisdiction @relation(fields: [jurisdiction], references: [code])

  @@id([jurisdiction, code])
}

model IngestionRun {
  id         String    @id @default(cuid())
  source     String
  status     String
  startedAt  DateTime  @default(now())
  finishedAt DateTime?
  laws       Int       @default(0)
  articles   Int       @default(0)
  sharia     Int       @default(0)
  note       String    @default("")
}
