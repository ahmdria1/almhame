{
  "expo": {
    "name": "المحامي الإلكتروني المتقدم",
    "slug": "elawyer",
    "version": "1.0.0",
    "scheme": "elawyer",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": false,
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#17345F"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.emuhami.app",
      "buildNumber": "1",
      "associatedDomains": ["applinks:emuhami.com"],
      "infoPlist": {
        "NSCameraUsageDescription": "لإرفاق صورة من الكاميرا بالمحادثة. Used to attach a photo from the camera to the chat.",
        "NSPhotoLibraryUsageDescription": "لإرفاق صورة من مكتبة الصور بالمحادثة. Used to attach a photo from the library to the chat.",
        "NSMicrophoneUsageDescription": "لتسجيل رسالة صوتية في المحادثة. Used to record a voice note in the chat."
      }
    },
    "android": {
      "package": "com.emuhami.app",
      "softwareKeyboardLayoutMode": "resize",
      "permissions": ["RECORD_AUDIO"],
      "versionCode": 1,
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#17345F"
      },
      "intentFilters": [
        {
          "action": "VIEW",
          "autoVerify": true,
          "data": [{ "scheme": "https", "host": "emuhami.com" }],
          "category": ["BROWSABLE", "DEFAULT"]
        }
      ]
    },
    "web": { "bundler": "metro", "output": "single" },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      [
        "expo-notifications",
        {
          "sounds": [
            "./assets/sounds/normal-1.wav",
            "./assets/sounds/normal-2.wav",
            "./assets/sounds/urgent-1.wav",
            "./assets/sounds/urgent-2.wav"
          ]
        }
      ],
      [
        "expo-av",
        {
          "microphonePermission": "لتسجيل رسالة صوتية في المحادثة. Used to record a voice note in the chat."
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "لإرفاق صورة من مكتبة الصور بالمحادثة. Used to attach a photo from the library to the chat.",
          "cameraPermission": "لإرفاق صورة من الكاميرا بالمحادثة. Used to attach a photo from the camera to the chat."
        }
      ]
    ],
    "experiments": { "typedRoutes": false }
  }
}
