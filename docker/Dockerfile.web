FROM node:22-bookworm-slim AS build
WORKDIR /app
RUN corepack enable
COPY package.json pnpm-lock.yaml pnpm-workspace.yaml turbo.json tsconfig.base.json .npmrc ./
COPY packages ./packages
COPY apps/web ./apps/web
COPY assets/fonts/Cairo-Variable.ttf ./apps/web/public/fonts/Cairo-Variable.ttf
ARG NEXT_PUBLIC_API_URL=http://127.0.0.1:4710/api
ARG BUILD_STAMP=release
ARG SITE_URL
ENV NEXT_PUBLIC_API_URL=$NEXT_PUBLIC_API_URL
ENV BUILD_STAMP=$BUILD_STAMP
ENV SITE_URL=$SITE_URL
RUN pnpm install --frozen-lockfile \
  && pnpm --filter @elawyer/types build \
  && pnpm --filter @elawyer/tokens build \
  && pnpm --filter @elawyer/i18n build \
  && pnpm --filter @elawyer/api-client build \
  && pnpm --filter @elawyer/web build
FROM node:22-bookworm-slim
WORKDIR /app
ENV NODE_ENV=production
ENV PORT=4720
COPY --from=build /app/apps/web/.next/standalone ./
COPY --from=build /app/apps/web/.next/static ./apps/web/.next/static
COPY --from=build /app/apps/web/public ./apps/web/public
EXPOSE 4720
CMD ["node", "apps/web/server.js"]
