FROM node:22-bookworm-slim
RUN apt-get update \
  && apt-get install -y --no-install-recommends openssl ca-certificates tesseract-ocr tesseract-ocr-ara tesseract-ocr-eng poppler-utils chromium \
  && rm -rf /var/lib/apt/lists/*
WORKDIR /app
RUN corepack enable
COPY package.json pnpm-lock.yaml pnpm-workspace.yaml turbo.json tsconfig.base.json .npmrc ./
COPY packages ./packages
COPY apps/api ./apps/api
COPY assets ./assets
COPY corpus ./corpus
RUN pnpm install --frozen-lockfile \
  && pnpm --filter @elawyer/types build \
  && pnpm --filter @elawyer/api exec prisma generate \
  && pnpm --filter @elawyer/api build
ENV NODE_ENV=production
ENV PORT=4710
ENV FONT_PATH=/app/assets/fonts/Cairo-Variable.ttf
ENV CHROMIUM_PATH=/usr/bin/chromium
EXPOSE 4710
CMD ["node", "apps/api/dist/main.js"]
