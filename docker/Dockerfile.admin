FROM node:22-bookworm-slim AS build
WORKDIR /app
RUN corepack enable
COPY package.json pnpm-lock.yaml pnpm-workspace.yaml turbo.json tsconfig.base.json .npmrc ./
COPY packages ./packages
COPY apps/admin ./apps/admin
COPY assets/fonts/Cairo-Variable.ttf ./apps/admin/public/fonts/Cairo-Variable.ttf
ARG NEXT_PUBLIC_API_URL=http://127.0.0.1:4710/api
ENV NEXT_PUBLIC_API_URL=$NEXT_PUBLIC_API_URL
RUN pnpm install --frozen-lockfile \
  && pnpm --filter @elawyer/types build \
  && pnpm --filter @elawyer/tokens build \
  && pnpm --filter @elawyer/i18n build \
  && pnpm --filter @elawyer/admin build
FROM node:22-bookworm-slim
WORKDIR /app
ENV NODE_ENV=production
ENV PORT=4730
COPY --from=build /app/apps/admin/.next/standalone ./
COPY --from=build /app/apps/admin/.next/static ./apps/admin/.next/static
COPY --from=build /app/apps/admin/public ./apps/admin/public
EXPOSE 4730
CMD ["node", "apps/admin/server.js"]
