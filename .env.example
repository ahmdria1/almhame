# Copy to .env at the repository root and to apps/api/.env.
# Never commit either file. Values below are local development placeholders.

NODE_ENV=development
PORT=4710
API_PUBLIC_URL=http://127.0.0.1:4710
WEB_ORIGIN=http://127.0.0.1:4720
ADMIN_ORIGIN=http://127.0.0.1:4730
CORS_ORIGINS=
NEXT_PUBLIC_API_URL=http://127.0.0.1:4710/api
# Absolute origin for canonical URLs, the sitemap, and Open Graph. No trailing slash.
SITE_URL=http://127.0.0.1:4720
EXPO_PUBLIC_API_URL=http://127.0.0.1:4710/api

DATABASE_URL=postgresql://elawyer:elawyer@127.0.0.1:5432/elawyer
TEST_DATABASE_URL=postgresql://elawyer:elawyer@127.0.0.1:5432/elawyer_test
# Set to 1 in CI when Docker can start pgvector/pgvector:pg16.
USE_TESTCONTAINERS=0

# 32 bytes, base64. Generate: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# The value below is a development key only.
KMS_MASTER_KEY=MDEyMzQ1Njc4OWFiY2RlZjAxMjM0NTY3ODlhYmNkZWY=
JWT_SECRET=replace-with-a-long-random-string
OTP_PEPPER=replace-with-another-long-random-string
# Development only. Production refuses to boot when either flag is true.
OTP_DEBUG=false
EMAIL_DEBUG=true
CHROMIUM_PATH=/usr/bin/google-chrome
# Empty host skips scanning outside production. Production refuses uploads when the scanner is down.
CLAMAV_HOST=
CLAMAV_PORT=3310
CLAMAV_REQUIRED=false
OUTBOX_DIR=./data/outbox

LLM_PROVIDER=mock
MODEL_BASE_URL=
MODEL_API_KEY=
MODEL_NAME=draft-model
EMBEDDING_PROVIDER=mock
EMBEDDING_BASE_URL=
EMBEDDING_API_KEY=
EMBEDDING_MODEL=embed-model

PAYMENT_GATEWAY=sandbox
PAYMENT_SANDBOX_SECRET=sandbox-dev-secret
PAY_PER_MEMO_HALALAS=2900
# Al Rajhi Bank hosted payment (payment gateway = alrajhi).
# The bank kit requires a fixed AES-CBC IV (PGKEYENCDECIVSPC). That value lives only in the gateway adapter.
# Resource key length is 16 or 32 bytes. Currency 682, action 1.
ALRAJHI_TRANPORTAL_ID=
ALRAJHI_TRANPORTAL_PASSWORD=
ALRAJHI_RESOURCE_KEY=
ALRAJHI_HOSTED_URL=https://securepayments.alrajhibank.com.sa/pg/payment/hosted.htm
ALRAJHI_RESPONSE_URL=http://127.0.0.1:4710/api/payments/callback
ALRAJHI_ERROR_URL=http://127.0.0.1:4710/api/payments/callback

SELLER_NAME=المحامي الإلكتروني المتقدم
SELLER_VAT_NUMBER=300000000000003
SELLER_ADDRESS=Riyadh, SA

STORAGE_DIR=./data/storage
FONT_PATH=
REDIS_URL=redis://127.0.0.1:6379

SENTRY_DSN=
NEXT_PUBLIC_SENTRY_DSN=

# Production refuses SMS_PROVIDER=mock. Use disabled when SMS is unused, or a real provider.
SMS_PROVIDER=mock
SMS_API_KEY=
SMS_SENDER=
SMS_BASE_URL=

INTEGRATIONS_MODE=stub
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URL=http://127.0.0.1:4710/api/integrations/google_drive/callback
MS_CLIENT_ID=
MS_CLIENT_SECRET=
MS_REDIRECT_URL=http://127.0.0.1:4710/api/integrations/onedrive/callback
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
# Transactional mail. Override to use another mailbox.
SMTP_FROM=no-reply@emuhami.com
# Empty keeps cookies host-only. Production compose sets .emuhami.com when this is unset.
COOKIE_DOMAIN=

PDPL_CONSENT_VERSION=2026-01
BUILD_STAMP=dev

# Production on the Hostinger VPS (2 vCPU, 8 GB). Replace the local values above
# before `docker compose build`. Canonical, sitemap, robots, and Open Graph URLs
# are read from SITE_URL at build time. Dev and CI keep http://127.0.0.1:4720.
# NODE_ENV=production
# SITE_URL=https://emuhami.com
# API_PUBLIC_URL=https://emuhami.com
# PUBLIC_API_URL=https://emuhami.com/api
# WEB_ORIGIN=https://emuhami.com
# ADMIN_ORIGIN=https://admin.emuhami.com
# CORS_ORIGINS=https://emuhami.com,https://admin.emuhami.com
# NEXT_PUBLIC_API_URL=https://emuhami.com/api
# COOKIE_DOMAIN=.emuhami.com
# SMTP_FROM=no-reply@emuhami.com
# ALRAJHI_RESPONSE_URL=https://emuhami.com/api/payments/callback
# ALRAJHI_ERROR_URL=https://emuhami.com/api/payments/callback
# GOOGLE_REDIRECT_URL=https://emuhami.com/api/integrations/google_drive/callback
# MS_REDIRECT_URL=https://emuhami.com/api/integrations/onedrive/callback
