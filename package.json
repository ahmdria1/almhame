{
  "name": "elawyer",
  "private": true,
  "version": "1.0.0",
  "description": "المحامي الإلكتروني المتقدم",
  "license": "UNLICENSED",
  "author": "Ahmed Alamrani",
  "packageManager": "pnpm@10.33.4",
  "pnpm": {
    "onlyBuiltDependencies": [
      "@nestjs/core",
      "@prisma/client",
      "@prisma/engines",
      "prisma",
      "esbuild",
      "sharp",
      "msgpackr-extract",
      "protobufjs",
      "ssh2",
      "cpu-features",
      "@napi-rs/canvas"
    ]
  },
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "turbo build",
    "dev": "turbo dev",
    "lint": "eslint .",
    "typecheck": "turbo typecheck",
    "test": "turbo test",
    "test:e2e": "playwright test",
    "db:migrate": "pnpm --filter @elawyer/api exec prisma migrate deploy",
    "db:seed": "pnpm --filter @elawyer/api seed"
  },
  "devDependencies": {
    "@playwright/test": "1.55.0",
    "@types/jest": "29.5.14",
    "@types/node": "22.15.30",
    "eslint": "9.28.0",
    "jest": "29.7.0",
    "ts-jest": "29.3.4",
    "turbo": "2.5.4",
    "typescript": "5.8.3",
    "typescript-eslint": "8.33.1"
  }
}
