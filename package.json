{
  "name": "elawyer",
  "private": true,
  "version": "1.0.0",
  "description": "المحامي الإلكتروني المتقدم",
  "license": "UNLICENSED",
  "author": "Ahmed Alamrani",
  "packageManager": "pnpm@10.33.4",
  "pnpm": {
    "overrides": {
      "@nestjs/platform-express>body-parser": "1.20.9",
      "express>body-parser": "1.20.9",
      "@nestjs/platform-express>multer": "2.5.0",
      "express>path-to-regexp": "0.1.13",
      "@nestjs/cli>glob": "10.5.0",
      "@angular-devkit/core>picomatch": "4.0.4",
      "postcss": "8.5.18",
      "next>sharp": "0.35.5",
      "@expo/cli>tar": "file:vendor/tar-default",
      "cacache>tar": "file:vendor/tar-default",
      "@expo/plist>@xmldom/xmldom": "0.8.15",
      "testcontainers>undici": "6.29.1",
      "undici>@fastify/busboy": "3.2.1",
      "get-uri>basic-ftp": "6.2.1",
      "metro>image-size": "file:vendor/image-size-callable",
      "chromium-bidi>zod": "4.6.6",
      "external-editor>tmp": "0.2.7"
    },
    "auditConfig": {
      "ignoreCves": [
        "CVE-2026-56876",
        "CVE-2026-19693"
      ]
    },
    "onlyBuiltDependencies": [
      "@nestjs/core",
      "@prisma/client",
      "@prisma/engines",
      "prisma",
      "esbuild",
      "sharp",
      "msgpackr-extract",
      "protobufjs",
      "ssh2",
      "cpu-features"
    ]
  },
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "turbo build",
    "dev": "turbo dev",
    "lint": "eslint . --max-warnings 0",
    "typecheck": "turbo typecheck",
    "test": "turbo test",
    "test:e2e": "playwright test",
    "test:lighthouse": "node scripts/ci/run-lighthouse.mjs",
    "db:migrate": "pnpm --filter @elawyer/api exec prisma migrate deploy",
    "db:seed": "pnpm --filter @elawyer/api seed"
  },
  "devDependencies": {
    "@lhci/cli": "0.15.1",
    "@playwright/test": "1.55.1",
    "@types/jest": "29.5.14",
    "@types/node": "22.15.30",
    "eslint": "9.28.0",
    "jest": "29.7.0",
    "ts-jest": "29.3.4",
    "turbo": "2.5.4",
    "typescript": "5.8.3",
    "typescript-eslint": "8.33.1"
  }
}
